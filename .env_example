# VK Bot Configuration (обязательно для работы формы)
# См. VK_SETUP.md для инструкции по настройке
# ВАЖНО: эти переменные серверные, НЕ используйте префикс NEXT_PUBLIC_
VK_BOT_TOKEN=
VK_ADMIN_USER_ID=

# Secret token for /api/leads/export (обязательно для экспорта лидов)
# Сгенерируйте: openssl rand -hex 32
EXPORT_SECRET=

# Optional: HTTPS webhook для интеграции с CRM/Google Sheets
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Optional: Дополнительные допустимые Origin для CSRF-проверки (через запятую)
# Указывайте полный origin без пути, через запятую.
# Пример: https://preview.etalon-penza.ru,https://staging.etalon-penza.ru
ALLOWED_ORIGINS=

# Optional: клиентский ключ JavaScript API Яндекс Карт для страницы контактов
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Optional: отдельный Telegram API route
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Docker Compose: по умолчанию порт доступен только локально
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
